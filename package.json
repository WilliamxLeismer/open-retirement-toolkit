{
  "name": "open-retirement-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude tests/performance.test.ts",
    "test:performance": "vitest run tests/performance.test.ts",
    "verify": "npm run test:coverage && npm run test:performance && npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
